# Database
DATABASE_URL="postgresql://user:password@localhost:5432/martin_pos?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# AI APIs
ANTHROPIC_API_KEY="your-claude-api-key"
OPENAI_API_KEY="your-openai-api-key"

# App Config
APP_PORT=3001
WEB_PORT=3000
NODE_ENV=development

# Instalación - Seleccionar módulo
# RESTAURANT | BOOKSTORE | MINIMARKET | ALL
INSTALLED_MODULE="ALL"

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Impresora
PRINTER_PORT="/dev/usb/lp0"
PRINTER_WIDTH=48
