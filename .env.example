# ========================================
# Martin POS - Environment Variables
# ========================================

# Database Configuration
DATABASE_URL="postgresql://martinpos:martinpos123@localhost:5436/martin_pos?schema=public"
POSTGRES_USER=martinpos
POSTGRES_PASSWORD=martinpos123
POSTGRES_DB=martin_pos
POSTGRES_PORT=5436

# Redis Configuration
REDIS_URL="redis://localhost:6380"
REDIS_PORT=6380

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# AI APIs
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# App Config
APP_PORT=3001
WEB_PORT=3008
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Instalación - Seleccionar módulo
# RESTAURANT | BOOKSTORE | MINIMARKET | ALL
INSTALLED_MODULE="ALL"

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Impresora
PRINTER_PORT="/dev/usb/lp0"
PRINTER_WIDTH=48

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Payment Gateways
# MERCADO_PAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
