// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole @default(CASHIER)
  isActive    Boolean  @default(true)
  phoneNumber String?
  avatar      String?

  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  sales              Sale[]
  stockMovements     StockMovement[]
  cashRegisters      CashRegister[]
  cashTransactions   CashTransaction[]
  orders             Order[]          @relation("WaiterOrders")
  aiQueries          AIQuery[]
  reports            Report[]
  shifts             EmployeeShift[]
  commissions        Commission[]
  createdTransfers   InventoryTransfer[] @relation("TransferCreatedBy")

  @@index([email])
  @@index([branchId])
  @@map("users")
}

model Branch {
  id          String     @id @default(cuid())
  name        String
  address     String
  phone       String
  email       String?
  moduleType  ModuleType @default(MINIMARKET)
  isActive    Boolean    @default(true)
  config      Json       @default("{}")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  // Relations
  users              User[]
  products           Product[]
  categories         Category[]
  sales              Sale[]
  stockMovements     StockMovement[]
  inventoryAlerts    InventoryAlert[]
  customers          Customer[]
  tables             Table[]
  orders             Order[]
  cashRegisters      CashRegister[]
  suppliers          Supplier[]
  settings           Settings[]
  reports            Report[]
  loyaltyPrograms    LoyaltyProgram[]
  promotions         Promotion[]
  transfersFrom      InventoryTransfer[] @relation("TransferFromBranch")
  transfersTo        InventoryTransfer[] @relation("TransferToBranch")
  deliveryOrders     DeliveryOrder[]
  invoices           Invoice[]

  @@index([moduleType])
  @@map("branches")
}

// ============================================
// PRODUCT & INVENTORY MODELS
// ============================================

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?

  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  products    Product[]

  @@index([branchId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String        @id @default(cuid())
  sku               String        @unique
  barcode           String?       @unique
  name              String
  description       String?
  price             Decimal       @db.Decimal(10, 2)
  costPrice         Decimal       @db.Decimal(10, 2)
  stock             Decimal       @default(0) @db.Decimal(10, 3)
  minStock          Decimal       @default(0) @db.Decimal(10, 3)
  maxStock          Decimal?      @db.Decimal(10, 3)
  unit              String        @default("UN")
  status            ProductStatus @default(ACTIVE)
  imageUrl          String?

  // Inventory control
  isPerishable      Boolean       @default(false)
  hasLotControl     Boolean       @default(false)
  requiresWeighing  Boolean       @default(false)
  expirationDate    DateTime?

  // Restaurant specific
  isRecipe          Boolean       @default(false)
  preparationTime   Int?          // minutes

  // Tax
  taxable           Boolean       @default(true)
  taxRate           Decimal?      @db.Decimal(5, 4)

  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])

  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  // Relations
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  inventoryAlerts   InventoryAlert[]
  orderItems        OrderItem[]
  recipe            Recipe?
  recipeIngredients RecipeIngredient[]
  productLots       ProductLot[]

  @@index([sku])
  @@index([barcode])
  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductLot {
  id              String   @id @default(cuid())
  lotNumber       String
  quantity        Decimal  @db.Decimal(10, 3)
  expirationDate  DateTime?
  receivedDate    DateTime @default(now())

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, lotNumber])
  @@index([expirationDate])
  @@map("product_lots")
}

model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  quantity      Decimal           @db.Decimal(10, 3)
  previousStock Decimal           @db.Decimal(10, 3)
  newStock      Decimal           @db.Decimal(10, 3)
  unitCost      Decimal?          @db.Decimal(10, 2)
  totalCost     Decimal?          @db.Decimal(10, 2)
  reason        String?
  referenceId   String?           // Sale ID, Purchase ID, etc.
  inputMethod   InputMethod       @default(MANUAL)

  productId     String
  product       Product           @relation(fields: [productId], references: [id])

  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])

  userId        String
  user          User              @relation(fields: [userId], references: [id])

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([productId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model InventoryAlert {
  id        String    @id @default(cuid())
  type      AlertType
  message   String
  priority  Priority  @default(MEDIUM)
  isRead    Boolean   @default(false)
  metadata  Json?

  productId String
  product   Product   @relation(fields: [productId], references: [id])

  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([branchId])
  @@index([isRead])
  @@index([priority])
  @@map("inventory_alerts")
}

// ============================================
// SALES MODELS
// ============================================

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  status        SaleStatus    @default(COMPLETED)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  notes         String?

  // Restaurant specific
  tableId       String?
  table         Table?        @relation(fields: [tableId], references: [id])
  orderId       String?

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])

  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])

  userId        String
  user          User          @relation(fields: [userId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  // Relations
  items         SaleItem[]
  cashTransaction CashTransaction?

  @@index([saleNumber])
  @@index([branchId])
  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  tax         Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  notes       String?

  productId   String
  product     Product @relation(fields: [productId], references: [id])

  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  taxId          String?  @unique
  loyaltyPoints  Int      @default(0)
  totalPurchases Decimal  @default(0) @db.Decimal(10, 2)

  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  sales              Sale[]
  loyaltyTransactions LoyaltyTransaction[]
  preferences        CustomerPreference[]
  layaways           Layaway[]

  @@index([branchId])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

// ============================================
// RESTAURANT SPECIFIC MODELS
// ============================================

model Table {
  id              String      @id @default(cuid())
  number          String
  capacity        Int
  status          TableStatus @default(AVAILABLE)
  currentOrderId  String?

  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Relations
  orders          Order[]
  sales           Sale[]

  @@unique([branchId, number])
  @@index([branchId])
  @@index([status])
  @@map("tables")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  notes       String?

  tableId     String
  table       Table       @relation(fields: [tableId], references: [id])

  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])

  waiterId    String?
  waiter      User?       @relation("WaiterOrders", fields: [waiterId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  // Relations
  items       OrderItem[]

  @@index([orderNumber])
  @@index([tableId])
  @@index([branchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String      @id @default(cuid())
  quantity    Int
  status      OrderStatus @default(PENDING)
  notes       String?
  preparedAt  DateTime?

  productId   String
  product     Product     @relation(fields: [productId], references: [id])

  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@map("order_items")
}

model Recipe {
  id             String             @id @default(cuid())
  name           String
  instructions   String?
  yield          Int                @default(1)
  costPerServing Decimal            @db.Decimal(10, 2)

  productId      String             @unique
  product        Product            @relation(fields: [productId], references: [id])

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  ingredients    RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String  @id @default(cuid())
  quantity  Decimal @db.Decimal(10, 3)
  unit      String

  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipeId])
  @@index([productId])
  @@map("recipe_ingredients")
}

// ============================================
// CASH REGISTER MODELS
// ============================================

model CashRegister {
  id           String    @id @default(cuid())
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  initialCash  Decimal   @db.Decimal(10, 2)
  finalCash    Decimal?  @db.Decimal(10, 2)
  expectedCash Decimal?  @db.Decimal(10, 2)
  difference   Decimal?  @db.Decimal(10, 2)
  totalSales   Decimal   @default(0) @db.Decimal(10, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(10, 2)
  status       CashRegisterStatus @default(OPEN)

  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])

  userId       String
  user         User      @relation(fields: [userId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  transactions CashTransaction[]

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@map("cash_registers")
}

model CashTransaction {
  id              String          @id @default(cuid())
  type            TransactionType
  amount          Decimal         @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  description     String

  cashRegisterId  String
  cashRegister    CashRegister    @relation(fields: [cashRegisterId], references: [id])

  userId          String
  user            User            @relation(fields: [userId], references: [id])

  saleId          String?         @unique
  sale            Sale?           @relation(fields: [saleId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([cashRegisterId])
  @@index([type])
  @@map("cash_transactions")
}

// ============================================
// SUPPLIER MODELS
// ============================================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxId       String?  @unique
  isActive    Boolean  @default(true)

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
  @@map("suppliers")
}

// ============================================
// AI & ANALYTICS MODELS
// ============================================

model AIQuery {
  id        String   @id @default(cuid())
  query     String
  response  String   @db.Text
  context   Json?
  metadata  Json?

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ai_queries")
}

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  title       String
  dateFrom    DateTime
  dateTo      DateTime
  data        Json
  generatedAt DateTime   @default(now())

  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id])

  generatedBy String
  user        User       @relation(fields: [generatedBy], references: [id])

  createdAt   DateTime   @default(now())

  @@index([branchId])
  @@index([type])
  @@index([generatedAt])
  @@map("reports")
}

// ============================================
// SETTINGS MODELS
// ============================================

model Settings {
  id         String     @id @default(cuid())
  moduleType ModuleType
  config     Json       @default("{}")

  branchId   String     @unique
  branch     Branch     @relation(fields: [branchId], references: [id])

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("settings")
}

// ============================================
// LOYALTY & CUSTOMER ENGAGEMENT MODELS
// ============================================

model LoyaltyProgram {
  id                String   @id @default(cuid())
  name              String
  description       String?
  pointsPerDollar   Decimal  @db.Decimal(10, 2)
  dollarPerPoint    Decimal  @db.Decimal(10, 2)
  minPointsToRedeem Int      @default(100)
  isActive          Boolean  @default(true)

  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  transactions      LoyaltyTransaction[]

  @@map("loyalty_programs")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  points      Int
  type        LoyaltyTransactionType
  description String?

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  programId   String
  program     LoyaltyProgram @relation(fields: [programId], references: [id])

  saleId      String?

  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([programId])
  @@map("loyalty_transactions")
}

model CustomerPreference {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])

  productId    String?
  categoryId   String?

  frequency    Int      @default(0)
  lastPurchase DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@map("customer_preferences")
}

// ============================================
// EMPLOYEE MANAGEMENT MODELS
// ============================================

model EmployeeShift {
  id         String    @id @default(cuid())
  startTime  DateTime
  endTime    DateTime?
  totalHours Decimal?  @db.Decimal(10, 2)
  notes      String?

  userId     String
  user       User      @relation(fields: [userId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([startTime])
  @@map("employee_shifts")
}

model Commission {
  id              String   @id @default(cuid())
  amount          Decimal  @db.Decimal(10, 2)
  percentage      Decimal  @db.Decimal(5, 2)
  baseSaleAmount  Decimal  @db.Decimal(10, 2)

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  saleId          String

  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("commissions")
}

// ============================================
// PROMOTIONS & COMBOS MODELS
// ============================================

model Promotion {
  id              String     @id @default(cuid())
  name            String
  description     String?
  type            PromotionType
  discountType    DiscountType
  discountValue   Decimal    @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean    @default(true)
  conditions      Json?

  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  comboProducts   ComboProduct[]

  @@index([branchId])
  @@index([isActive])
  @@map("promotions")
}

model ComboProduct {
  id          String    @id @default(cuid())
  quantity    Int       @default(1)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  productId   String

  createdAt   DateTime  @default(now())

  @@index([promotionId])
  @@map("combo_products")
}

// ============================================
// MULTI-BRANCH TRANSFER MODELS
// ============================================

model InventoryTransfer {
  id            String         @id @default(cuid())
  transferNumber String        @unique
  status        TransferStatus @default(PENDING)
  notes         String?

  fromBranchId  String
  fromBranch    Branch         @relation("TransferFromBranch", fields: [fromBranchId], references: [id])

  toBranchId    String
  toBranch      Branch         @relation("TransferToBranch", fields: [toBranchId], references: [id])

  createdById   String
  createdBy     User           @relation("TransferCreatedBy", fields: [createdById], references: [id])

  sentAt        DateTime?
  receivedAt    DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  items         TransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("inventory_transfers")
}

model TransferItem {
  id         String            @id @default(cuid())
  quantity   Decimal           @db.Decimal(10, 3)

  productId  String

  transferId String
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())

  @@index([transferId])
  @@map("transfer_items")
}

// ============================================
// DELIVERY INTEGRATION MODELS
// ============================================

model DeliveryOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  provider        DeliveryProvider
  externalId      String?
  status          DeliveryStatus @default(PENDING)
  deliveryFee     Decimal        @db.Decimal(10, 2)

  customerName    String
  customerPhone   String
  deliveryAddress String
  notes           String?

  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id])

  orderId         String?

  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([branchId])
  @@index([provider])
  @@index([status])
  @@map("delivery_orders")
}

// ============================================
// LAYAWAY (APARTADOS) MODELS
// ============================================

model Layaway {
  id              String        @id @default(cuid())
  layawayNumber   String        @unique
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal       @db.Decimal(10, 2)
  status          LayawayStatus @default(ACTIVE)
  dueDate         DateTime

  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  items           LayawayItem[]
  payments        LayawayPayment[]

  @@index([customerId])
  @@index([status])
  @@map("layaways")
}

model LayawayItem {
  id         String  @id @default(cuid())
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  productId  String

  layawayId  String
  layaway    Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([layawayId])
  @@map("layaway_items")
}

model LayawayPayment {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  paymentMethod PaymentMethod

  layawayId   String
  layaway     Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([layawayId])
  @@map("layaway_payments")
}

// ============================================
// CONSIGNMENT MODELS
// ============================================

model Consignment {
  id              String           @id @default(cuid())
  consignmentNumber String         @unique
  status          ConsignmentStatus @default(ACTIVE)
  commissionRate  Decimal          @db.Decimal(5, 2)

  supplierId      String

  startDate       DateTime
  endDate         DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  items           ConsignmentItem[]

  @@map("consignments")
}

model ConsignmentItem {
  id            String      @id @default(cuid())
  quantity      Int
  soldQuantity  Int         @default(0)
  returnedQuantity Int      @default(0)
  price         Decimal     @db.Decimal(10, 2)

  productId     String

  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([consignmentId])
  @@map("consignment_items")
}

// ============================================
// ELECTRONIC INVOICING MODELS
// ============================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  type            InvoiceType   @default(INVOICE)
  status          InvoiceStatus @default(DRAFT)

  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)

  customerId      String?
  customerName    String
  customerTaxId   String?
  customerAddress String?

  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])

  saleId          String?

  xmlData         String?       @db.Text
  pdfUrl          String?

  issuedAt        DateTime?
  voidedAt        DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  items           InvoiceItem[]

  @@index([branchId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  tax         Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  productId   String?

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================
// HARDWARE INTEGRATION MODELS
// ============================================

model Scale {
  id          String   @id @default(cuid())
  name        String
  port        String
  baudRate    Int      @default(9600)
  isActive    Boolean  @default(true)

  branchId    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scales")
}

model TemperatureLog {
  id          String   @id @default(cuid())
  location    String
  temperature Decimal  @db.Decimal(5, 2)
  humidity    Decimal? @db.Decimal(5, 2)
  isAlert     Boolean  @default(false)

  branchId    String

  createdAt   DateTime @default(now())

  @@index([branchId])
  @@index([createdAt])
  @@map("temperature_logs")
}

// ============================================
// FRAUD DETECTION MODELS
// ============================================

model FraudAlert {
  id          String     @id @default(cuid())
  type        FraudType
  severity    Priority
  description String
  metadata    Json?
  status      AlertStatus @default(PENDING)

  saleId      String?
  userId      String?

  createdAt   DateTime   @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("fraud_alerts")
}

// ============================================
// PAYMENT GATEWAY INTEGRATION MODELS
// ============================================

model PaymentGatewayTransaction {
  id                String              @id @default(cuid())
  gateway           PaymentGateway
  transactionId     String
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("USD")
  status            PaymentStatus

  saleId            String?

  requestData       Json?
  responseData      Json?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([gateway])
  @@index([status])
  @@map("payment_gateway_transactions")
}

// ============================================
// ADVANCED AI MODELS
// ============================================

model AIVoiceCommand {
  id          String   @id @default(cuid())
  audioUrl    String?
  transcript  String
  command     String?
  confidence  Decimal  @db.Decimal(5, 4)
  executed    Boolean  @default(false)

  userId      String

  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("ai_voice_commands")
}

model AIOCRDocument {
  id          String   @id @default(cuid())
  imageUrl    String
  documentType String
  extractedData Json
  confidence  Decimal  @db.Decimal(5, 4)
  verified    Boolean  @default(false)

  userId      String

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([documentType])
  @@map("ai_ocr_documents")
}

model AIProductRecognition {
  id          String   @id @default(cuid())
  imageUrl    String
  productId   String?
  confidence  Decimal  @db.Decimal(5, 4)
  verified    Boolean  @default(false)

  userId      String

  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("ai_product_recognitions")
}

