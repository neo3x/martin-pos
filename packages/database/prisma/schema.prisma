// ============================================
// TRANSBANK PHYSICAL POS TERMINAL MODELS
// ============================================

model POSTerminal {
  id                  String            @id @default(cuid())
  terminalId          String            @unique  // ID Ãºnico del terminal
  serialNumber        String?           // NÃºmero de serie
  model               String?           // Modelo del equipo (VX520, VX680, etc.)
  name                String            // Nombre descriptivo
  location            String?           // UbicaciÃ³n en local

  // ConexiÃ³n
  connectionType      POSConnectionType @default(USB)
  port                String?           // COM3, /dev/ttyUSB0, IP:puerto
  baudRate            Int               @default(9600)
  ipAddress           String?
  macAddress          String?

  // Estado
  status              POSTerminalStatus @default(DISCONNECTED)
  lastPingAt          DateTime?
  lastTransactionAt   DateTime?

  // ConfiguraciÃ³n Transbank
  configId            String
  config              TransbankConfig   @relation(fields: [configId], references: [id])

  branchId            String
  isActive            Boolean           @default(true)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  transactions        POSTransaction[]

  @@index([branchId])
  @@index([status])
  @@map("pos_terminals")
}

model POSTransaction {
  id                  String              @id @default(cuid())
  saleId              String?
  terminalId          String
  terminal            POSTerminal         @relation(fields: [terminalId], references: [id])

  // Datos de la transacciÃ³n
  operationCode       String              // CÃ³digo de operaciÃ³n (venta, anulaciÃ³n, etc.)
  amount              Int                 // Monto en CLP
  tip                 Int                 @default(0)  // Propina
  totalAmount         Int                 // amount + tip
  installments        Int                 @default(0)  // Cuotas

  // Respuesta del terminal
  status              POSTransactionStatus @default(PENDING)
  authorizationCode   String?
  responseCode        Int?
  responseMessage     String?

  // Datos de la tarjeta (enmascarados)
  cardNumber          String?             // Ãšltimos 4 dÃ­gitos
  cardType            String?             // VISA, MASTERCARD, AMEX, etc.
  cardBrand           String?             // DEBIT, CREDIT

  // Voucher
  voucherNumber       String?
  commerceCode        String?
  terminalCode        String?
  transactionDate     DateTime?
  transactionTime     String?

  // Datos adicionales
  printData           String?             @db.Text  // Datos para impresiÃ³n de voucher
  rawResponse         Json?               // Respuesta completa del terminal

  // Timestamps
  initiatedAt         DateTime            @default(now())
  completedAt         DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([saleId])
  @@index([terminalId])
  @@index([status])
  @@index([createdAt])
  @@map("pos_transactions")
}

model POSBatch {
  id                  String          @id @default(cuid())
  branchId            String
  terminalId          String

  batchNumber         Int
  openedAt            DateTime        @default(now())
  closedAt            DateTime?
  status              POSBatchStatus  @default(OPEN)

  // Totales del lote
  totalTransactions   Int             @default(0)
  totalSales          Int             @default(0)  // Cantidad de ventas
  totalVoids          Int             @default(0)  // Cantidad de anulaciones
  totalAmount         Int             @default(0)  // Monto total
