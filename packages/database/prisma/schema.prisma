  creditCount         Int             @default(0)
  debitAmount         Int             @default(0)
  debitCount          Int             @default(0)

  // Cierre
  closingData         Json?
  closingReport       String?         @db.Text

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([branchId])
  @@index([terminalId])
  @@index([status])
  @@map("pos_batches")
}

