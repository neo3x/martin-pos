model DTEDocument {
  id                  String        @id @default(cuid())
  branchId            String
  saleId              String?

  // Tipo de documento (33=Factura, 39=Boleta, 61=Nota CrÃ©dito)
  tipoDTE             Int
  folio               Int

  // Datos emisor
  rutEmisor           String
  razonSocialEmisor   String

  // Datos receptor
  rutReceptor         String?
  razonSocialReceptor String?
  giroReceptor        String?
  direccionReceptor   String?
  comunaReceptor      String?

  // Montos
  montoNeto           Int
  montoExento         Int           @default(0)
  tasaIVA             Int           @default(19)
  iva                 Int
  montoTotal          Int

  // Impuestos adicionales (ILA para alcohol)
  tipoImpAdicional    Int?          // CÃ³digo impuesto adicional
  tasaImpAdicional    Decimal?      @db.Decimal(5, 2)
  montoImpAdicional   Int?

  // Estado SII
  status              DTEStatus     @default(DRAFT)
  trackId             String?       // ID de seguimiento SII
  estadoSII           String?       // Estado devuelto por SII
  glosaEstadoSII      String?       // DescripciÃ³n estado

  // XML y PDF
  xmlContent          String?       @db.Text
  xmlSigned           String?       @db.Text
  pdfUrl              String?
  tedBarcode          String?       @db.Text  // CÃ³digo de barras TED

  // Fechas
  fechaEmision        DateTime      @default(now())
  fechaVencimiento    DateTime?

  // Referencias (para notas de crÃ©dito)
  referenciaTipoDTE   Int?
  referenciaFolio     Int?
  referenciaRazon     String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sentToSIIAt         DateTime?
  acceptedBySIIAt     DateTime?

  // Relations
  items               DTEItem[]

  @@unique([branchId, tipoDTE, folio])
  @@index([branchId])
  @@index([rutReceptor])
  @@index([status])
  @@index([fechaEmision])
  @@map("dte_documents")
}

model DTEItem {
  id                  String      @id @default(cuid())
