# Multi-stage build for backend
FROM node:18-bullseye-slim AS builder

# Install pnpm
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy workspace config and package files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/backend/package.json ./packages/backend/

# Install dependencies (use --no-frozen-lockfile as fallback when no lockfile exists)
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY packages/backend ./packages/backend
COPY turbo.json ./

# Build shared, generate prisma, build backend
RUN pnpm --filter @martin-pos/shared build
RUN cd packages/database && npx prisma generate
RUN pnpm --filter @martin-pos/database build
RUN pnpm --filter @martin-pos/backend build

# Production stage
FROM node:18-bullseye-slim

WORKDIR /app

# Copy full workspace to preserve pnpm links at runtime
COPY --from=builder /app /app

WORKDIR /app/packages/backend

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "const http=require('http');http.get('http://localhost:3001/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1));"

# Run migrations and start
CMD ["sh", "-c", "npx prisma migrate deploy --schema=../database/prisma/schema.prisma 2>/dev/null; node dist/main.js"]
