# Multi-stage build for web frontend
FROM node:18-alpine AS builder

RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy workspace config and package files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/web/package.json ./packages/web/

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web
COPY turbo.json ./

# Ensure optional static assets directory exists for final COPY
RUN mkdir -p /app/packages/web/public

# Build shared first, then web
RUN pnpm --filter @martin-pos/shared build

# Set build-time env vars
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @martin-pos/web build

# Production stage
FROM node:18-alpine

WORKDIR /app

# Copy full workspace to preserve pnpm links at runtime
COPY --from=builder /app /app

WORKDIR /app/packages/web

EXPOSE 3000

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "node_modules/next/dist/bin/next", "start"]
