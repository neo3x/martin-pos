{
  "name": "martin-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema POS multi-módulo asistido por IA para Restaurantes, Librerías y Minimarkets",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @martin-pos/database prisma generate",
    "db:migrate": "pnpm --filter @martin-pos/database prisma migrate dev",
    "db:studio": "pnpm --filter @martin-pos/database prisma studio",
    "backend:dev": "pnpm --filter @martin-pos/backend dev",
    "web:dev": "pnpm --filter @martin-pos/web dev",
    "mobile:dev": "pnpm --filter @martin-pos/mobile start",
    "desktop:dev": "pnpm --filter @martin-pos/desktop dev"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
